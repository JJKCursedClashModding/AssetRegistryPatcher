{
  "name": "asset-registry-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Merge AssetManifest.json rows into a base cooked AssetRegistry.bin (v16).",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test tests/registry.test.mjs",
    "start": "npm run build && node dist/cli.js",
    "merge": "npm run build && node dist/cli.js merge",
    "build:exe": "npm run build && node scripts/build-exe.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "jiti": "^2.6.1"
  }
}
